[Unit]
Description=YunMu BLE meter Prometheus exporter (Rust)
After=bluetooth.service network-online.target
Wants=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/local/bin/yunmu-meter --config /etc/yunmu-meter/meters.toml --interval 0.8 --port 9103
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
